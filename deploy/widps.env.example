# Copy to /etc/widps/widps.env, set owner root and mode 600. Never commit the real file.
#   sudo install -d -m 700 /etc/widps
#   sudo install -m 600 deploy/widps.env.example /etc/widps/widps.env
#   echo "WIDPS_HMAC_KEY=$(openssl rand -hex 32)" | sudo tee -a /etc/widps/widps.env >/dev/null

# Required: at least 32 bytes as hex. The backend refuses to start without it.
# Alternative: WIDPS_HMAC_KEY_FILE=/etc/widps/hmac.key (a file containing the hex key).
WIDPS_HMAC_KEY=

# Optional: serve the management-frame model (see widps-docs/ML_REEVALUATION.md).
# WIDPS_MODEL_DIR=ml/output_mgmt
# WIDPS_REQUIRE_MODEL_MANIFEST=1
