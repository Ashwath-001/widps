# WIDPS backend settings for local runs (`cargo run` / target/*/widps started from widps-backend/).
# Copy to .env and fill in. .env is git-ignored; never commit real values.
# On the sensor, systemd uses /etc/widps/widps.env instead (see deploy/widps.env.example).
# Variables already set in the shell or by systemd take precedence over this file.

# Required. HMAC key for the alert and audit hash chains, hex, at least 32 bytes.
# Generate: openssl rand -hex 32
# Alternative: WIDPS_HMAC_KEY_FILE=/path/to/file-containing-the-hex-key
WIDPS_HMAC_KEY=

# API listener; keep it on loopback behind nginx.
WIDPS_BIND=127.0.0.1:8787

# SQLite database and alert JSONL mirror.
WIDPS_DB=data/widps.db
WIDPS_ALERTS_JSONL=widps_alerts.jsonl

# Sessions: idle timeout (minutes), absolute lifetime (hours), anomaly policy (alert_only | force_relogin).
WIDPS_SESSION_IDLE_MIN=15
WIDPS_SESSION_ABSOLUTE_HOURS=8
WIDPS_SESSION_ANOMALY_POLICY=alert_only

# Extra origins allowed to send state-changing requests, comma-separated (e.g. a dev server on another host).
# WIDPS_ALLOWED_ORIGINS=http://localhost:5173

# ML: model directory read by ml/inference.py, and whether a SHA-256 manifest is mandatory.
# WIDPS_MODEL_DIR=ml/output_mgmt
# WIDPS_REQUIRE_MODEL_MANIFEST=1

# SIEM forwarding (Wazuh/syslog).
WIDPS_SIEM_ENABLED=0
WIDPS_SIEM_HOST=127.0.0.1
WIDPS_SIEM_PORT=1514
WIDPS_SIEM_FORMAT=json
WIDPS_SIEM_TCP=0
