# WIDPS dashboard settings for `npm run dev` / `npm run preview`.
# Copy to .env (git-ignored). These are read only by vite.config.ts and are NOT bundled into the app:
# only variables prefixed VITE_ reach the browser, and none are used. Never put secrets in VITE_* variables.

# Backend the dev server proxies /api to (the backend binds 127.0.0.1:8787 by default).
WIDPS_API_TARGET=http://127.0.0.1:8787

# Dev server address. Use 127.0.0.1 to keep it off the network; 0.0.0.0 exposes it to the LAN.
WIDPS_DEV_HOST=127.0.0.1
WIDPS_DEV_PORT=5173
