<!--
  WIDPS Custom Rules for Wazuh
  ================================
  Maps WIDPS alert severities to Wazuh rule levels.
  Rule IDs 100100-100199 reserved for WIDPS.
-->

<group name="widps,wireless_ids,">

  <!-- Base rule: any WIDPS alert -->
  <rule id="100100" level="3">
    <decoded_as>widps-json</decoded_as>
    <description>WIDPS: Wireless intrusion detection alert</description>
    <group>widps,</group>
  </rule>

  <!-- Medium severity: reconnaissance, probing -->
  <rule id="100101" level="6">
    <if_sid>100100</if_sid>
    <field name="severity">Medium</field>
    <description>WIDPS Medium: $(title)</description>
    <group>widps,recon,</group>
  </rule>

  <!-- High severity: active attack detected -->
  <rule id="100102" level="10">
    <if_sid>100100</if_sid>
    <field name="severity">High</field>
    <description>WIDPS High: $(title)</description>
    <group>widps,attack,</group>
  </rule>

  <!-- Critical severity: confirmed active threat -->
  <rule id="100103" level="14">
    <if_sid>100100</if_sid>
    <field name="severity">Critical</field>
    <description>WIDPS Critical: $(title)</description>
    <group>widps,attack,critical,</group>
    <options>alert_by_email</options>
  </rule>

  <!-- Specific attack patterns -->
  <rule id="100110" level="12">
    <if_sid>100100</if_sid>
    <match>Deauth</match>
    <description>WIDPS: Deauthentication flood detected</description>
    <group>widps,dos,deauth,</group>
  </rule>

  <rule id="100111" level="13">
    <if_sid>100100</if_sid>
    <match>Evil Twin|Rogue AP</match>
    <description>WIDPS: Rogue AP / Evil Twin detected</description>
    <group>widps,evil_twin,rogue_ap,</group>
  </rule>

  <rule id="100112" level="11">
    <if_sid>100100</if_sid>
    <match>Karma</match>
    <description>WIDPS: Karma attack detected</description>
    <group>widps,karma,mitm,</group>
  </rule>

  <rule id="100113" level="10">
    <if_sid>100100</if_sid>
    <match>Sequence Anomaly|MAC Spoof</match>
    <description>WIDPS: MAC spoofing / Sequence anomaly</description>
    <group>widps,spoofing,</group>
  </rule>

  <rule id="100114" level="8">
    <if_sid>100100</if_sid>
    <match>Probe.*Flood|Reconnaissance</match>
    <description>WIDPS: Network reconnaissance detected</description>
    <group>widps,recon,probe,</group>
  </rule>

  <rule id="100115" level="14">
    <if_sid>100100</if_sid>
    <match>Composite Threat Score</match>
    <description>WIDPS: Multi-factor threat score threshold exceeded</description>
    <group>widps,composite,critical,</group>
  </rule>

  <!-- ML-specific rules -->
  <rule id="100120" level="10">
    <if_sid>100100</if_sid>
    <match>AI classified</match>
    <description>WIDPS ML: AI-based attack classification triggered</description>
    <group>widps,ml,ai,</group>
  </rule>

  <!-- Honeypot connection (Sprint 2) -->
  <rule id="100130" level="12">
    <if_sid>100100</if_sid>
    <match>Honeypot</match>
    <description>WIDPS: Device connected to honeypot AP — confirmed attacker</description>
    <group>widps,honeypot,confirmed_threat,</group>
  </rule>

</group>
